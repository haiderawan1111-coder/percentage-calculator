---
import "../styles/global.css";

import type { SEOData } from "../seo";
import { createSchema } from "../seo";
import { siteConfig } from "../config/site";
import Toast from "../components/ui/Toast.astro";

interface Props {
  seo: SEOData;
}

const { seo } = Astro.props;

const siteName = siteConfig.name;

const schema = createSchema(seo);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <!-- Performance -->

    <meta
      name="color-scheme"
      content="light"
    />

    <meta
      name="referrer"
      content="strict-origin-when-cross-origin"
    />

    <meta
      name="format-detection"
      content="telephone=no,email=no,address=no"
    />

    <link
      rel="dns-prefetch"
      href="//quickcalctools.com"
    />

    <link
      rel="preconnect"
      href="https://quickcalctools.com"
      crossorigin
    />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <!-- Primary SEO -->

    <title>{seo.title}</title>

    <meta
      name="description"
      content={seo.description}
    />

    <link
      rel="canonical"
      href={seo.canonical}
    />

    <!-- Additional SEO -->

    <meta
      name="robots"
      content="index, follow"
    />

    <meta
      name="author"
      content={seo.author ?? siteConfig.author}
    />

    <meta
      name="keywords"
      content={seo.keywords.join(", ")}
    />

    <meta
      name="theme-color"
      content="#2563eb"
    />

    <!-- Open Graph -->

    <meta
      property="og:type"
      content={seo.pageType ?? "website"}
    />

    <meta
      property="og:site_name"
      content={seo.openGraph?.siteName ?? siteName}
    />

    <meta
      property="og:locale"
      content={seo.openGraph?.locale ?? "en_US"}
    />

    <meta
      property="og:title"
      content={seo.openGraph?.title ?? seo.title}
    />

    <meta
      property="og:description"
      content={seo.openGraph?.description ?? seo.description}
    />

    <meta
      property="og:url"
      content={seo.openGraph?.url ?? seo.canonical}
    />

    <meta
      property="og:image"
      content={seo.openGraph?.image}
    />

    <meta
      property="og:image:url"
      content={seo.openGraph?.image}
    />

    <meta
      property="og:image:secure_url"
      content={seo.openGraph?.secureImage ?? seo.openGraph?.image}
    />

    <meta
      property="og:image:type"
      content={seo.openGraph?.imageType ?? "image/png"}
    />

    <meta
      property="og:image:width"
      content={String(seo.openGraph?.imageWidth ?? 1200)}
    />

    <meta
      property="og:image:height"
      content={String(seo.openGraph?.imageHeight ?? 630)}
    />

    <meta
      property="og:image:alt"
      content={seo.openGraph?.imageAlt ?? seo.title}
    />

    <!-- Twitter / X -->

    <meta
      name="twitter:card"
      content={seo.twitter?.card ?? "summary_large_image"}
    />

    <meta
      name="twitter:site"
      content={seo.twitter?.site ?? siteConfig.social.twitter}
    />

    <meta
      name="twitter:creator"
      content={seo.twitter?.creator ?? siteConfig.social.twitter}
    />

    <meta
      name="twitter:title"
      content={seo.twitter?.title ?? seo.openGraph?.title ?? seo.title}
    />

    <meta
      name="twitter:description"
      content={
        seo.twitter?.description ??
        seo.openGraph?.description ??
        seo.description
      }
    />

    <meta
      name="twitter:image"
      content={seo.twitter?.image ?? seo.openGraph?.image}
    />

    <meta
      name="twitter:image:alt"
      content={seo.twitter?.imageAlt ?? seo.openGraph?.imageAlt ?? seo.title}
    />

    <!-- Icons -->

    <link
      rel="icon"
      href="/favicon.ico"
    />

    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
    />

    <!-- JSON-LD -->

    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900">
    <!-- Header -->

    <header class="border-b border-slate-200 bg-white">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
        <a
          href="/"
          class="text-lg font-bold text-blue-600 transition-colors hover:text-blue-700"
        >
          {siteName}
        </a>
      </nav>
    </header>

    <!-- Main Content -->

    <main class="py-8">
      <slot />
    </main>

    <!-- Footer -->

    <footer class="mt-16 border-t border-slate-200 bg-white">
      <div
        class="mx-auto max-w-7xl px-4 py-6 text-center text-sm text-slate-500 sm:px-6 lg:px-8"
      >
        © {new Date().getFullYear()} {siteName}. All rights reserved.
      </div>
    </footer>

    <Toast />
  </body>
</html>