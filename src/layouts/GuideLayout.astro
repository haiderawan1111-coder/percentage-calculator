---
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  author: string;
}

const {
  title,
  description,
  publishDate,
  updatedDate,
  author,
} = Astro.props;
---

<article class="overflow-hidden rounded-2xl bg-white shadow-sm">
  <header class="border-b border-slate-200 px-8 py-10">
    <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-blue-600">
      Percentage Guides
    </p>

    <h1 class="text-4xl font-bold leading-tight text-slate-900">
      {title}
    </h1>

    <p class="mt-4 text-lg leading-8 text-slate-600">
      {description}
    </p>

    <div class="mt-8 grid gap-4 border-t border-slate-200 pt-6 text-sm text-slate-600 sm:grid-cols-3">
      <div>
        <p class="font-medium text-slate-900">
          Published
        </p>

        <p>
          {publishDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </p>
      </div>

      <div>
        <p class="font-medium text-slate-900">
          Last Updated
        </p>

        <p>
          {
            updatedDate
              ? updatedDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })
              : "—"
          }
        </p>
      </div>

      <div>
        <p class="font-medium text-slate-900">
          Author
        </p>

        <p>{author}</p>
      </div>
    </div>
  </header>

  <section class="prose prose-slate max-w-none px-8 py-10 lg:prose-lg">
    <slot />
  </section>
</article>