---
import CalculatorLayout from "./calculator/CalculatorLayout.astro";
import NumberInput from "./calculator/NumberInput.astro";
import ResultCard from "./calculator/ResultCard.astro";
import ActionBar from "./calculator/ActionBar.astro";
---

<CalculatorLayout title="What is X% of Y?">
  <form id="percentage-form" class="mt-6 space-y-4" novalidate>
    <NumberInput
      id="percent-x"
      name="percent-x"
      label="X (the percentage)"
      placeholder="e.g. 20"
    />

    <NumberInput
      id="percent-y"
      name="percent-y"
      label="Y (the total value)"
      placeholder="e.g. 150"
    />

    <ActionBar />
  </form>

  <ResultCard />
</CalculatorLayout>

<script>
  import "../scripts/percentageCalculator.ts";
</script>