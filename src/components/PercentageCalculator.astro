---

<section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-8">
  <h2 class="text-lg font-semibold text-slate-900">
    What is X% of Y?
  </h2>

  <form id="percentage-form" class="mt-6 space-y-4" novalidate>
    <div>
      <label
        for="percent-x"
        class="block text-sm font-medium text-slate-700"
      >
        X (the percentage)
      </label>

      <input
        type="number"
        id="percent-x"
        name="percent-x"
        placeholder="e.g. 20"
        step="any"
        inputmode="decimal"
        autocomplete="off"
        class="mt-1 w-full rounded-lg border border-slate-300 px-4 py-2.5 text-base focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
      />
    </div>

    <div>
      <label
        for="percent-y"
        class="block text-sm font-medium text-slate-700"
      >
        Y (the total value)
      </label>

      <input
        type="number"
        id="percent-y"
        name="percent-y"
        placeholder="e.g. 150"
        step="any"
        inputmode="decimal"
        autocomplete="off"
        class="mt-1 w-full rounded-lg border border-slate-300 px-4 py-2.5 text-base focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
      />
    </div>

    <div class="flex flex-col gap-3 pt-2 sm:flex-row">
      <button
        type="submit"
        class="w-full rounded-lg bg-blue-600 px-6 py-2.5 font-semibold text-white hover:bg-blue-700 sm:w-auto"
      >
        Calculate
      </button>

      <button
        type="reset"
        class="w-full rounded-lg border border-slate-300 bg-white px-6 py-2.5 font-semibold text-slate-700 hover:bg-slate-50 sm:w-auto"
      >
        Reset
      </button>
    </div>
  </form>

  <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-6">
    <p class="text-sm font-medium text-slate-500">
      Result
    </p>

    <p
      id="result-description"
      class="mt-2 text-slate-600"
    >
      Enter values and click Calculate.
    </p>

    <p
      id="result-value"
      class="mt-2 text-2xl font-bold text-slate-900"
    >
      —
    </p>
  </div>
</section>

<script>
  import "../scripts/percentageCalculator.ts";
</script>