---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Heading from "../ui/Heading.astro";
import Text from "../ui/Text.astro";
import Card from "../ui/Card.astro";

const steps = [
  {
    number: "01",
    title: "Enter Your Values",
    description:
      "Type the numbers you want to calculate in the calculator fields.",
  },
  {
    number: "02",
    title: "Choose the Calculation",
    description:
      "Select percentage, percentage increase, decrease, or another calculation.",
  },
  {
    number: "03",
    title: "Get Instant Results",
    description:
      "The calculator instantly provides an accurate answer without reloading the page.",
  },
];
---

<Section>
  <Container>
    <div class="mx-auto max-w-3xl text-center">
      <Heading as="h2">
        How It Works
      </Heading>

      <div class="mt-4">
        <Text size="lg">
          Calculate percentages in three simple steps.
        </Text>
      </div>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        steps.map((step) => (
          <Card class="text-center">
            <div class="text-4xl font-extrabold text-blue-600">
              {step.number}
            </div>

            <h3 class="mt-5 text-xl font-semibold text-slate-900">
              {step.title}
            </h3>

            <p class="mt-3 text-slate-600">
              {step.description}
            </p>
          </Card>
        ))
      }
    </div>
  </Container>
</Section>