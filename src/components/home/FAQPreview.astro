---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Heading from "../ui/Heading.astro";
import Card from "../ui/Card.astro";

const faqs = [
  {
    question: "How do I calculate percentages?",
    answer:
      "Divide the part by the whole and multiply the result by 100.",
  },
  {
    question: "How do I calculate percentage increase?",
    answer:
      "Subtract the original value from the new value, divide by the original value, then multiply by 100.",
  },
  {
    question: "Is this percentage calculator free?",
    answer:
      "Yes. It is completely free and works on desktop, tablet, and mobile devices.",
  },
];
---

<Section>
  <Container>
    <div class="mx-auto max-w-3xl">
      <div class="text-center">
        <Heading as="h2">
          Frequently Asked Questions
        </Heading>
      </div>

      <div class="mt-10 space-y-6">
        {
          faqs.map((faq) => (
            <Card>
              <h3 class="text-lg font-semibold text-slate-900">
                {faq.question}
              </h3>

              <p class="mt-3 text-slate-600">
                {faq.answer}
              </p>
            </Card>
          ))
        }
      </div>
    </div>
  </Container>
</Section>