---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Heading from "../ui/Heading.astro";
import Text from "../ui/Text.astro";
import Button from "../ui/Button.astro";
---

<Section>
  <Container>
    <div class="rounded-3xl bg-blue-600 px-8 py-16 text-center text-white">
      <Heading
        as="h2"
        class="text-white"
      >
        Ready to Calculate Percentages?
      </Heading>

      <div class="mx-auto mt-5 max-w-2xl">
        <Text class="text-blue-100">
          Use our free percentage calculator to solve percentage problems
          instantly. Fast, accurate, and completely free.
        </Text>
      </div>

      <div class="mt-8">
        <Button
          href="#calculator"
          class="bg-white text-blue-600 hover:bg-slate-100"
        >
          Start Calculating
        </Button>
      </div>
    </div>
  </Container>
</Section>