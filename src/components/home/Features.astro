---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import FeatureCard from "../ui/FeatureCard.astro";

const features = [
  {
    title: "Fast Calculations",
    description:
      "Get accurate percentage calculations instantly without waiting.",
    icon: "⚡",
  },
  {
    title: "100% Free",
    description:
      "Use all calculator features completely free with no hidden charges.",
    icon: "💯",
  },
  {
    title: "Mobile Friendly",
    description:
      "Works perfectly on desktop, tablet, and mobile devices.",
    icon: "📱",
  },
  {
    title: "Accurate Results",
    description:
      "Reliable percentage calculations for students, businesses, and professionals.",
    icon: "🎯",
  },
];
---

<Section>
  <Container>
    <SectionHeader
      title="Why Choose QuickCalc Tools?"
      description="A simple, fast, and reliable percentage calculator designed for everyday calculations."
    />

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        features.map((feature) => (
          <FeatureCard
            icon={feature.icon}
            title={feature.title}
            description={feature.description}
          />
        ))
      }
    </div>
  </Container>
</Section>