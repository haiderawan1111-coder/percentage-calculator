---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import Heading from "../ui/Heading.astro";
import Text from "../ui/Text.astro";
import Card from "../ui/Card.astro";

const features = [
  {
    title: "Fast Calculations",
    description:
      "Get accurate percentage calculations instantly without waiting.",
    icon: "⚡",
  },
  {
    title: "100% Free",
    description:
      "Use all calculator features completely free with no hidden charges.",
    icon: "💯",
  },
  {
    title: "Mobile Friendly",
    description:
      "Works perfectly on desktop, tablet, and mobile devices.",
    icon: "📱",
  },
  {
    title: "Accurate Results",
    description:
      "Reliable percentage calculations for students, businesses, and professionals.",
    icon: "🎯",
  },
];
---

<Section>
  <Container>
    <div class="mx-auto max-w-3xl text-center">
      <Heading as="h2">
        Why Choose QuickCalc Tools?
      </Heading>

      <div class="mt-4">
        <Text size="lg">
          A simple, fast, and reliable percentage calculator designed for
          everyday calculations.
        </Text>
      </div>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        features.map((feature) => (
          <Card>
            <div class="text-4xl">{feature.icon}</div>

            <h3 class="mt-5 text-xl font-semibold text-slate-900">
              {feature.title}
            </h3>

            <p class="mt-3 text-slate-600">
              {feature.description}
            </p>
          </Card>
        ))
      }
    </div>
  </Container>
</Section>