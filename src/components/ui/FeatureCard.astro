---
import Card from "./Card.astro";
import Text from "./Text.astro";

interface Props {
  icon: string;
  title: string;
  description: string;
  class?: string;
}

const {
  icon,
  title,
  description,
  class: className = "",
} = Astro.props;
---

<Card class={className}>
  <div class="text-4xl">
    {icon}
  </div>

  <h3 class="mt-5 text-xl font-semibold text-slate-900">
    {title}
  </h3>

  <Text class="mt-3">
    {description}
  </Text>
</Card>