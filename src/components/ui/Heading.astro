---
type HeadingTag = "h1" | "h2" | "h3" | "h4";

interface Props {
  as?: HeadingTag;
  class?: string;
}

const props = Astro.props as Props;

const as: HeadingTag = props.as ?? "h2";
const className = props.class ?? "";

const styles: Record<HeadingTag, string> = {
  h1: "text-4xl md:text-5xl font-extrabold tracking-tight",
  h2: "text-3xl md:text-4xl font-bold tracking-tight",
  h3: "text-2xl font-bold",
  h4: "text-xl font-semibold",
};

const headingClass = `${styles[as]} text-slate-900 ${className}`;
---

{
  as === "h1" ? (
    <h1 class={headingClass}><slot /></h1>
  ) : as === "h2" ? (
    <h2 class={headingClass}><slot /></h2>
  ) : as === "h3" ? (
    <h3 class={headingClass}><slot /></h3>
  ) : (
    <h4 class={headingClass}><slot /></h4>
  )
}