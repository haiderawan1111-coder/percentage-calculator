---
type HeadingTag = "h1" | "h2" | "h3" | "h4";

interface Props {
  as?: HeadingTag;
  class?: string;
}

const props = Astro.props as Props;

const as: HeadingTag = props.as ?? "h2";
const className = props.class ?? "";

const styles: Record<HeadingTag, string> = {
  h1: "text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl lg:text-6xl",
  h2: "text-3xl font-bold leading-tight tracking-tight sm:text-4xl lg:text-5xl",
  h3: "text-2xl font-semibold leading-snug sm:text-3xl",
  h4: "text-xl font-semibold leading-snug sm:text-2xl",
};

const headingClass = `${styles[as]} text-slate-900 ${className}`;
---

{
  as === "h1" ? (
    <h1 class={headingClass}>
      <slot />
    </h1>
  ) : as === "h2" ? (
    <h2 class={headingClass}>
      <slot />
    </h2>
  ) : as === "h3" ? (
    <h3 class={headingClass}>
      <slot />
    </h3>
  ) : (
    <h4 class={headingClass}>
      <slot />
    </h4>
  )
}