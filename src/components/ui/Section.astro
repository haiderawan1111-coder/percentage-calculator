---
interface Props {
  class?: string;
  as?: "section" | "div";
}

const {
  class: className = "",
  as = "section",
} = Astro.props;
---

{
  as === "div" ? (
    <div class={`py-12 md:py-16 lg:py-20 ${className}`}>
      <slot />
    </div>
  ) : (
    <section class={`py-12 md:py-16 lg:py-20 ${className}`}>
      <slot />
    </section>
  )
}