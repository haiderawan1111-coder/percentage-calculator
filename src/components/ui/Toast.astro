<div
  id="toast"
  class="pointer-events-none fixed bottom-4 left-1/2 z-50 hidden -translate-x-1/2 rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white shadow-lg"
  role="status"
  aria-live="polite"
  aria-atomic="true"
></div>

<script>
  declare global {
    interface Window {
      showToast?: (message: string, duration?: number) => void;
    }
  }

  const toast = document.getElementById("toast") as HTMLDivElement | null;

  if (toast && !window.showToast) {
    let timeoutId: number | undefined;

    window.showToast = (message: string, duration = 2000) => {
      toast.textContent = message;
      toast.classList.remove("hidden");

      if (timeoutId) {
        window.clearTimeout(timeoutId);
      }

      timeoutId = window.setTimeout(() => {
        toast.classList.add("hidden");
      }, duration);
    };
  }
</script>