---
interface Props {
  size?: "sm" | "base" | "lg";
  muted?: boolean;
  class?: string;
}

const {
  size = "base",
  muted = true,
  class: className = "",
} = Astro.props;

const sizes = {
  sm: "text-sm",
  base: "text-base",
  lg: "text-lg",
};

const color = muted ? "text-slate-600" : "text-slate-900";
---

<p class={`${sizes[size]} leading-7 ${color} ${className}`}>
  <slot />
</p>