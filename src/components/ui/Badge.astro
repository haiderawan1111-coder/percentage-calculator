---
interface Props {
  variant?: "primary" | "success" | "warning" | "neutral";
  class?: string;
}

const {
  variant = "primary",
  class: className = "",
} = Astro.props;

const variants = {
  primary: "bg-blue-100 text-blue-700",
  success: "bg-green-100 text-green-700",
  warning: "bg-amber-100 text-amber-700",
  neutral: "bg-slate-100 text-slate-700",
};
---

<span
  class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ${variants[variant]} ${className}`}
>
  <slot />
</span>