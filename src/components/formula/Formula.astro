---
import type { FormulaSection } from "../../data/formulas/types";

interface Props {
  section: FormulaSection;
}

const { section } = Astro.props;
---

{
  section && (
    <section class="mt-12 rounded-xl border border-slate-200 p-6">
      {section.title && (
        <h2 class="text-2xl font-bold">{section.title}</h2>
      )}

      <div class="mt-4 rounded-lg bg-slate-100 p-4 text-center font-mono text-lg">
        {section.formula}
      </div>

      {section.explanation && (
        <p class="mt-4 text-slate-700">
          {section.explanation}
        </p>
      )}

      {section.steps && section.steps.length > 0 && (
        <div class="mt-6">
          <h3 class="text-lg font-semibold">
            How to calculate
          </h3>

          <ol class="mt-3 list-decimal space-y-3 pl-6">
            {section.steps.map((step) => (
              <li>
                {step.title && (
                  <strong>{step.title}: </strong>
                )}
                {step.content}
              </li>
            ))}
          </ol>
        </div>
      )}
    </section>
  )
}