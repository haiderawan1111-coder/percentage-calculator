---
interface Props {
  title: string;
  class?: string;
}

const {
  title,
  class: className = "",
} = Astro.props;
---

<section
  class={`rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-8 ${className}`}
  style="content-visibility:auto;contain-intrinsic-size:700px;"
>
  <h2 class="text-lg font-semibold text-slate-900">
    {title}
  </h2>

  <slot />
</section>