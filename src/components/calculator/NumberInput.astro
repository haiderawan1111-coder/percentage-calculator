---
interface Props {
  id: string;
  name: string;
  label: string;
  placeholder?: string;
  step?: string;
  required?: boolean;
  class?: string;
}

const {
  id,
  name,
  label,
  placeholder = "",
  step = "any",
  required = false,
  class: className = "",
} = Astro.props;
---

<div class={className}>
  <label
    for={id}
    class="block text-sm font-medium text-slate-700"
  >
    {label}
  </label>

  <input
    id={id}
    name={name}
    type="number"
    placeholder={placeholder}
    step={step}
    required={required}
    inputmode="decimal"
    autocomplete="off"
    class="mt-1 w-full rounded-lg border border-slate-300 px-4 py-2.5 text-base focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200"
  />
</div>