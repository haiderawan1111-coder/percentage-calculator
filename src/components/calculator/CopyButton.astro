---
interface Props {
  targetId?: string;
}

const {
  targetId = "result-value",
} = Astro.props;
---

<button
  type="button"
  id="copy-result-button"
  data-target={targetId}
  class="mt-4 inline-flex items-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-100"
>
  📋 Copy Result
</button>