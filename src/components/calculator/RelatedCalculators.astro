---
import Card from "../ui/Card.astro";
import Heading from "../ui/Heading.astro";
import Button from "../ui/Button.astro";

import { getRelatedCalculators } from "../../utils/related";

interface Props {
  currentSlug: string;
  title?: string;
  limit?: number;
}

const {
  currentSlug,
  title = "Related Calculators",
  limit = 4,
} = Astro.props;

const related = getRelatedCalculators(currentSlug, limit);
---

{
  related.length > 0 && (
    <section class="mt-16">
      <Heading as="h2">
        {title}
      </Heading>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {related.map((calculator) => (
          <Card>
            <h3 class="text-xl font-semibold text-slate-900">
              {calculator.title}
            </h3>

            <p class="mt-3 text-slate-600">
              {calculator.description}
            </p>

            <div class="mt-6">
              <Button href={calculator.href}>
                Open Calculator
              </Button>
            </div>
          </Card>
        ))}
      </div>
    </section>
  )
}