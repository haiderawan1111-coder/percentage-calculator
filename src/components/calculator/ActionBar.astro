---
import Button from "../ui/Button.astro";

interface Props {
  submitText?: string;
  resetText?: string;
}

const {
  submitText = "Calculate",
  resetText = "Reset",
} = Astro.props;
---

<div class="flex flex-col gap-3 pt-2 sm:flex-row">
  <Button type="submit">
    {submitText}
  </Button>

  <Button
    type="reset"
    variant="secondary"
  >
    {resetText}
  </Button>
</div>