---
import type { FAQSection } from "../../faq";

interface Props {
  section: FAQSection;
}

const { section } = Astro.props;
---

{
  section.items.length > 0 && (
    <section class="faq-section">
      {section.title && <h2>{section.title}</h2>}

      <div class="faq-list">
        {section.items.map((item) => (
          <details>
            <summary>{item.question}</summary>

            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )
}