---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const guides = await getCollection(
  "guides",
  ({ data }) => !data.draft
);

const sortedGuides = [...guides].sort(
  (a, b) =>
    b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout
  seo={{
    title: "Percentage Guides",
    description:
      "Learn percentages with free step-by-step guides from QuickCalc Tools.",
    canonical: "/guides/",
    keywords: [
      "percentage guides",
      "percentage tutorial",
      "percentage calculator guide",
    ],
  }}
>
  <section class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold text-slate-900">
      Percentage Guides
    </h1>

    <p class="mt-3 text-slate-600">
      Learn percentage concepts with simple, practical guides.
    </p>

    <p class="mt-2 text-sm text-slate-500">
      {sortedGuides.length} guide{sortedGuides.length === 1 ? "" : "s"} available
    </p>

    <div class="mt-8 space-y-4">
      {sortedGuides.map((guide) => (
        <article
          class="rounded-lg border border-slate-200 p-5 transition hover:shadow-md"
        >
          <h2 class="text-xl font-semibold">
            <a
              href={`/guides/${guide.id}/`}
              class="text-blue-600 hover:underline"
            >
              {guide.data.title}
            </a>
          </h2>

          <p class="mt-2 text-slate-600">
            {guide.data.description}
          </p>

          <p class="mt-3 text-sm text-slate-500">
            Published:
            {guide.data.publishDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>