---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Heading from "../components/ui/Heading.astro";
import Text from "../components/ui/Text.astro";

import PercentageErrorCalculator from "../components/PercentageErrorCalculator.astro";
import RelatedCalculators from "../components/calculator/RelatedCalculators.astro";

import FAQ from "../components/faq/FAQ.astro";
import FAQSchema from "../components/seo/FAQSchema.astro";
import FormulaSchema from "../components/seo/FormulaSchema.astro";
import ContentSchema from "../components/seo/ContentSchema.astro";

import Formula from "../components/formula/Formula.astro";

import HowItWorks from "../components/content/HowItWorks.astro";
import WorkedExample from "../components/content/WorkedExample.astro";
import CommonMistakes from "../components/content/CommonMistakes.astro";
import Tips from "../components/content/Tips.astro";

import { createSEO } from "../seo";
import { percentageErrorFAQ } from "../data/faqs";
import { percentageErrorFormula } from "../data/formulas";
import { percentageErrorContent } from "../data/content";

const seo = createSEO({
  title: "Percentage Error Calculator (Free Online)",

  description:
    "Calculate percentage error instantly using the actual and experimental values. Free, fast, and accurate online calculator.",

  canonical: "/percentage-error",

  keywords: [
    "percentage error calculator",
    "calculate percentage error",
    "experimental error calculator",
    "percentage error formula",
  ],
});
---

<BaseLayout seo={seo}>
  <FAQSchema section={percentageErrorFAQ} />
  <FormulaSchema section={percentageErrorFormula} />
  <ContentSchema section={percentageErrorContent} />

  <Section>
    <Container>
      <div class="mx-auto max-w-5xl">
        <div class="mb-10 text-center">
          <Heading as="h1">
            Percentage Error Calculator
          </Heading>

          <div class="mx-auto mt-4 max-w-3xl">
            <Text size="lg">
              Calculate the percentage error between an actual value and an
              experimental value instantly.
            </Text>
          </div>
        </div>

        <Card class="p-8">
          <PercentageErrorCalculator />
        </Card>

        <div class="mt-10">
          <RelatedCalculators currentSlug="percentage-error" />
        </div>

        <div class="mt-12">
          <Formula section={percentageErrorFormula} />
        </div>

        <div class="mt-12">
          <HowItWorks section={percentageErrorContent.howItWorks} />
        </div>

        <div class="mt-12">
          <WorkedExample section={percentageErrorContent.example} />
        </div>

        <div class="mt-12">
          <CommonMistakes section={percentageErrorContent.commonMistakes} />
        </div>

        <div class="mt-12">
          <Tips section={percentageErrorContent.tips} />
        </div>

        <div class="mt-12">
          <FAQ section={percentageErrorFAQ} />
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>