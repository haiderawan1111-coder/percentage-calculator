---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Heading from "../../components/ui/Heading.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";

import { createSEO } from "../../seo";

const seo = createSEO({
  title: "Percentage Calculators | QuickCalc Tools",
  description:
    "Free online percentage calculators including percentage increase, percentage decrease, percentage change, percentage difference and more.",
  canonical: "/calculators/",
  keywords: [
    "percentage calculators",
    "percentage calculator",
    "online percentage calculator",
    "percentage increase calculator",
    "percentage decrease calculator",
    "percentage change calculator",
    "percentage difference calculator",
  ],
});

const calculators = [
  {
    title: "Percentage Calculator",
    description: "Calculate percentages quickly and accurately.",
    href: "/",
  },
  {
    title: "Percentage Increase Calculator",
    description: "Calculate percentage increase between two values.",
    href: "/percentage-increase-calculator/",
  },
  {
    title: "Percentage Decrease Calculator",
    description: "Calculate percentage decrease instantly.",
    href: "/percentage-decrease-calculator/",
  },
  {
    title: "Percentage Change Calculator",
    description: "Find the percentage change from one value to another.",
    href: "/percentage-change-calculator/",
  },
  {
    title: "Percentage Difference Calculator",
    description: "Compare two numbers using percentage difference.",
    href: "/percentage-difference-calculator/",
  },
  {
    title: "Percentage of Number Calculator",
    description: "Calculate any percentage of a number.",
    href: "/percentage-of-number-calculator/",
  },
  {
    title: "What Percent Calculator",
    description: "Find what percent one number is of another.",
    href: "/what-percent-calculator/",
  },
];
---

<BaseLayout seo={seo}>
  <Section>
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <Heading as="h1">
          Percentage Calculators
        </Heading>

        <p class="mt-6 text-lg text-slate-600">
          Access all of our free percentage calculators in one place. Whether
          you need to calculate percentages, percentage increase, percentage
          decrease, percentage change or percentage difference, these tools are
          fast, accurate and work on any device.
        </p>
      </div>
    </Container>
  </Section>

  <Section class="pt-0">
    <Container>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {calculators.map((calculator) => (
          <Card>
            <h2 class="text-xl font-semibold text-slate-900">
              {calculator.title}
            </h2>

            <p class="mt-3 text-slate-600">
              {calculator.description}
            </p>

            <div class="mt-6">
              <Button href={calculator.href}>
                Open Calculator
              </Button>
            </div>
          </Card>
        ))}
      </div>
    </Container>
  </Section>

  <Section class="bg-slate-50">
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <Heading>
          Why Use Our Calculators?
        </Heading>

        <div class="mt-10 grid gap-6 md:grid-cols-2">
          <Card>
            <h3 class="font-semibold text-slate-900">
              Fast Results
            </h3>
            <p class="mt-2 text-slate-600">
              Get accurate calculations instantly without manual formulas.
            </p>
          </Card>

          <Card>
            <h3 class="font-semibold text-slate-900">
              Mobile Friendly
            </h3>
            <p class="mt-2 text-slate-600">
              Use every calculator easily on desktop, tablet and mobile.
            </p>
          </Card>

          <Card>
            <h3 class="font-semibold text-slate-900">
              Accurate
            </h3>
            <p class="mt-2 text-slate-600">
              Reliable calculations you can trust for work, school and everyday use.
            </p>
          </Card>

          <Card>
            <h3 class="font-semibold text-slate-900">
              Free Forever
            </h3>
            <p class="mt-2 text-slate-600">
              No registration, no downloads and completely free to use.
            </p>
          </Card>
        </div>
      </div>
    </Container>
  </Section>

  <Section>
    <Container>
      <Card class="text-center">
        <Heading as="h2">
          Need a Specific Percentage Calculator?
        </Heading>

        <p class="mt-4 text-slate-600">
          Browse our growing collection of free percentage tools designed for
          students, professionals and everyday calculations.
        </p>

        <div class="mt-8">
          <Button href="/">
            Go to Home
          </Button>
        </div>
      </Card>
    </Container>
  </Section>
</BaseLayout>