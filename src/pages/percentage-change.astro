---
import BaseLayout from "../layouts/BaseLayout.astro";

import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Heading from "../components/ui/Heading.astro";
import Text from "../components/ui/Text.astro";

import PercentageChangeCalculator from "../components/PercentageChangeCalculator.astro";
import RelatedCalculators from "../components/calculator/RelatedCalculators.astro";
import TopicLinks from "../components/topic/TopicLinks.astro";

import FAQ from "../components/faq/FAQ.astro";
import FAQSchema from "../components/seo/FAQSchema.astro";
import FormulaSchema from "../components/seo/FormulaSchema.astro";
import ContentSchema from "../components/seo/ContentSchema.astro";

import Formula from "../components/formula/Formula.astro";

import HowItWorks from "../components/content/HowItWorks.astro";
import WorkedExample from "../components/content/WorkedExample.astro";
import CommonMistakes from "../components/content/CommonMistakes.astro";
import Tips from "../components/content/Tips.astro";

import { createSEO } from "../seo";

import { percentageChangeFAQ } from "../data/faqs";
import { percentageChangeFormula } from "../data/formulas";
import { percentageTopic } from "../data/topics";
import { percentageChangeContent } from "../data/content";

const seo = createSEO({
  title: "Percentage Change Calculator",

  description:
    "Calculate the percentage increase or decrease between two values instantly. Fast, accurate, and free.",

  canonical: "/percentage-change",

  keywords: [
    "percentage change calculator",
    "percentage increase calculator",
    "percentage decrease calculator",
    "percent change",
    "calculate percentage change",
    "change between two numbers",
  ],
});
---

<BaseLayout seo={seo}>
  <FAQSchema section={percentageChangeFAQ} />
  <FormulaSchema section={percentageChangeFormula} />
  <ContentSchema section={percentageChangeContent} />

  <Section>
    <Container>
      <div class="mx-auto max-w-5xl">
        <div class="mb-10 text-center">
          <Heading as="h1">
            Percentage Change Calculator
          </Heading>

          <div class="mx-auto mt-4 max-w-3xl">
            <Text size="lg">
              Calculate the percentage increase or decrease between two values
              instantly. Fast, accurate, free, and works perfectly on desktop,
              tablet, and mobile devices.
            </Text>
          </div>
        </div>

        <Card class="p-8">
          <PercentageChangeCalculator />
        </Card>

        <div class="mt-10">
          <RelatedCalculators currentSlug="percentage-change" />
        </div>

        <div class="mt-12">
          <TopicLinks
            topic={percentageTopic}
            currentSlug="/percentage-change"
          />
        </div>

        <div class="mt-12">
          <Formula section={percentageChangeFormula} />
        </div>

        <div class="mt-12">
          <HowItWorks section={percentageChangeContent.howItWorks} />
        </div>

        <div class="mt-12">
          <WorkedExample section={percentageChangeContent.example} />
        </div>

        <div class="mt-12">
          <CommonMistakes section={percentageChangeContent.commonMistakes} />
        </div>

        <div class="mt-12">
          <Tips section={percentageChangeContent.tips} />
        </div>

        <div class="mt-12">
          <FAQ section={percentageChangeFAQ} />
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>