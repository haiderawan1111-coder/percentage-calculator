---
import BaseLayout from "../layouts/BaseLayout.astro";

import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Heading from "../components/ui/Heading.astro";
import Text from "../components/ui/Text.astro";

import PercentageDecreaseCalculator from "../components/PercentageDecreaseCalculator.astro";
import RelatedCalculators from "../components/calculator/RelatedCalculators.astro";
import TopicLinks from "../components/topic/TopicLinks.astro";

import FAQ from "../components/faq/FAQ.astro";
import FAQSchema from "../components/seo/FAQSchema.astro";
import FormulaSchema from "../components/seo/FormulaSchema.astro";
import ContentSchema from "../components/seo/ContentSchema.astro";

import Formula from "../components/formula/Formula.astro";

import HowItWorks from "../components/content/HowItWorks.astro";
import WorkedExample from "../components/content/WorkedExample.astro";
import CommonMistakes from "../components/content/CommonMistakes.astro";
import Tips from "../components/content/Tips.astro";

import { createSEO } from "../seo";

import { percentageDecreaseFAQ } from "../data/faqs";
import { percentageDecreaseFormula } from "../data/formulas";
import { percentageTopic } from "../data/topics";
import { percentageDecreaseContent } from "../data/content";

const seo = createSEO({
  title: "Percentage Decrease Calculator (Free Online)",

  description:
    "Calculate percentage decrease instantly. Subtract any percentage from a number with this free online percentage decrease calculator.",

  canonical: "/percentage-decrease",

  keywords: [
    "percentage decrease calculator",
    "decrease by percentage",
    "percentage decrease",
    "decrease calculator",
    "subtract percentage",
    "percentage reduction calculator",
  ],
});
---

<BaseLayout seo={seo}>
  <FAQSchema section={percentageDecreaseFAQ} />
  <FormulaSchema section={percentageDecreaseFormula} />
  <ContentSchema section={percentageDecreaseContent} />

  <Section>
    <Container>
      <div class="mx-auto max-w-5xl">
        <div class="mb-10 text-center">
          <Heading as="h1">
            Percentage Decrease Calculator
          </Heading>

          <div class="mx-auto mt-4 max-w-3xl">
            <Text size="lg">
              Decrease any number by a percentage instantly. Fast, accurate,
              free, and works perfectly on desktop, tablet, and mobile devices.
            </Text>
          </div>
        </div>

        <Card class="p-8">
          <PercentageDecreaseCalculator />
        </Card>

        <div class="mt-10">
          <RelatedCalculators currentSlug="percentage-decrease" />
        </div>

        <div class="mt-12">
          <TopicLinks
            topic={percentageTopic}
            currentSlug="/percentage-decrease"
          />
        </div>

        <div class="mt-12">
          <Formula section={percentageDecreaseFormula} />
        </div>

        <div class="mt-12">
          <HowItWorks section={percentageDecreaseContent.howItWorks} />
        </div>

        <div class="mt-12">
          <WorkedExample section={percentageDecreaseContent.example} />
        </div>

        <div class="mt-12">
          <CommonMistakes section={percentageDecreaseContent.commonMistakes} />
        </div>

        <div class="mt-12">
          <Tips section={percentageDecreaseContent.tips} />
        </div>

        <div class="mt-12">
          <FAQ section={percentageDecreaseFAQ} />
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>