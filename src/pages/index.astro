---
import BaseLayout from "../layouts/BaseLayout.astro";
import PercentageCalculator from "../components/PercentageCalculator.astro";

const pageTitle = "Percentage Calculator - Fast & Free Online Tool";

const pageDescription =
  "Calculate percentages instantly with our free online percentage calculator.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="text-center py-8 sm:py-12">
    <h1 class="text-3xl sm:text-4xl font-bold text-slate-900">
      Percentage Calculator
    </h1>

    <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-xl mx-auto">
      Quickly find out what X% of a number is.
    </p>
  </section>

  <PercentageCalculator />
</BaseLayout>