---
import BaseLayout from "../layouts/BaseLayout.astro";

import Hero from "../components/home/Hero.astro";
import CalculatorSection from "../components/home/CalculatorSection.astro";
import Features from "../components/home/Features.astro";
import PopularCalculations from "../components/home/PopularCalculations.astro";
import HowItWorks from "../components/home/HowItWorks.astro";
import FAQPreview from "../components/home/FAQPreview.astro";
import CTASection from "../components/home/CTASection.astro";

import { createSEO } from "../seo";

const seo = createSEO({
  title: "Percentage Calculator (Free & Fast) | Calculate Percentages Online",

  description:
    "Free online percentage calculator. Calculate percentages, percentage increase, percentage decrease, and percentage difference instantly.",

  canonical: "/",

  keywords: [
    "percentage calculator",
    "online percentage calculator",
    "calculate percentage",
    "percentage increase calculator",
    "percentage decrease calculator",
    "percentage difference calculator",
    "free percentage calculator",
  ],
});
---

<BaseLayout seo={seo}>
  <Hero />

  <CalculatorSection />

  <PopularCalculations />

  <Features />

  <HowItWorks />

  <FAQPreview />

  <CTASection />
</BaseLayout>