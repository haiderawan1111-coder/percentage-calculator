---
import BaseLayout from "../layouts/BaseLayout.astro";

import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Heading from "../components/ui/Heading.astro";
import Text from "../components/ui/Text.astro";

import SalesTaxCalculator from "../components/SalesTaxCalculator.astro";
import RelatedCalculators from "../components/calculator/RelatedCalculators.astro";
import TopicLinks from "../components/topic/TopicLinks.astro";

import FAQ from "../components/faq/FAQ.astro";
import FAQSchema from "../components/seo/FAQSchema.astro";
import FormulaSchema from "../components/seo/FormulaSchema.astro";
import ContentSchema from "../components/seo/ContentSchema.astro";

import Formula from "../components/formula/Formula.astro";

import HowItWorks from "../components/content/HowItWorks.astro";
import WorkedExample from "../components/content/WorkedExample.astro";
import CommonMistakes from "../components/content/CommonMistakes.astro";
import Tips from "../components/content/Tips.astro";

import { createSEO } from "../seo";

import { salesTaxFAQ } from "../data/faqs";
import { salesTaxFormula } from "../data/formulas";
import { percentageTopic } from "../data/topics";
import { salesTaxContent } from "../data/content";

const seo = createSEO({
  title: "Sales Tax Calculator",

  description:
    "Calculate sales tax amount and total price instantly. Free online sales tax calculator.",

  canonical: "/sales-tax",

  keywords: [
    "sales tax calculator",
    "sales tax",
    "tax calculator",
    "price with tax",
    "sales tax amount",
    "total price calculator",
  ],
});
---

<BaseLayout seo={seo}>
  <FAQSchema section={salesTaxFAQ} />
  <FormulaSchema section={salesTaxFormula} />
  <ContentSchema section={salesTaxContent} />

  <Section>
    <Container>
      <div class="mx-auto max-w-5xl">
        <div class="mb-10 text-center">
          <Heading as="h1">
            Sales Tax Calculator
          </Heading>

          <div class="mx-auto mt-4 max-w-3xl">
            <Text size="lg">
              Calculate sales tax amount and total price instantly. Fast,
              accurate, free, and works on desktop, tablet, and mobile
              devices.
            </Text>
          </div>
        </div>

        <Card class="p-8">
          <SalesTaxCalculator />
        </Card>

        <div class="mt-10">
          <RelatedCalculators currentSlug="sales-tax" />
        </div>

        <div class="mt-12">
          <TopicLinks
            topic={percentageTopic}
            currentSlug="/sales-tax"
          />
        </div>

        <div class="mt-12">
          <Formula section={salesTaxFormula} />
        </div>

        <div class="mt-12">
          <HowItWorks section={salesTaxContent.howItWorks} />
        </div>

        <div class="mt-12">
          <WorkedExample section={salesTaxContent.example} />
        </div>

        <div class="mt-12">
          <CommonMistakes section={salesTaxContent.commonMistakes} />
        </div>

        <div class="mt-12">
          <Tips section={salesTaxContent.tips} />
        </div>

        <div class="mt-12">
          <FAQ section={salesTaxFAQ} />
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>