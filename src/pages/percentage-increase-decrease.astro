---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Heading from "../components/ui/Heading.astro";
import Text from "../components/ui/Text.astro";

import PercentageIncreaseDecreaseCalculator from "../components/PercentageIncreaseDecreaseCalculator.astro";

import { createSEO } from "../seo";

const seo = createSEO({
  title: "Percentage Increase or Decrease Calculator (Free Online)",

  description:
    "Calculate whether a value increased or decreased and by what percentage. Free online percentage increase and decrease calculator.",

  canonical: "/percentage-increase-decrease",

  keywords: [
    "percentage increase and decrease calculator",
    "percentage change calculator",
    "increase or decrease percentage",
    "percentage comparison calculator",
  ],
});
---

<BaseLayout seo={seo}>
  <Section>
    <Container>
      <div class="mx-auto max-w-5xl">
        <div class="mb-10 text-center">
          <Heading as="h1">
            Percentage Increase / Decrease Calculator
          </Heading>

          <div class="mx-auto mt-4 max-w-3xl">
            <Text size="lg">
              Compare two values and instantly see whether the result is a percentage increase or decrease.
            </Text>
          </div>
        </div>

        <Card class="p-8">
          <PercentageIncreaseDecreaseCalculator />
        </Card>
      </div>
    </Container>
  </Section>
</BaseLayout>