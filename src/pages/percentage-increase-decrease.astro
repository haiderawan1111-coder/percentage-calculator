---
import BaseLayout from "../layouts/BaseLayout.astro";

import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import Heading from "../components/ui/Heading.astro";
import Text from "../components/ui/Text.astro";

import PercentageIncreaseDecreaseCalculator from "../components/PercentageIncreaseDecreaseCalculator.astro";
import RelatedCalculators from "../components/calculator/RelatedCalculators.astro";
import TopicLinks from "../components/topic/TopicLinks.astro";

import FAQ from "../components/faq/FAQ.astro";
import FAQSchema from "../components/seo/FAQSchema.astro";
import FormulaSchema from "../components/seo/FormulaSchema.astro";
import ContentSchema from "../components/seo/ContentSchema.astro";

import Formula from "../components/formula/Formula.astro";

import HowItWorks from "../components/content/HowItWorks.astro";
import WorkedExample from "../components/content/WorkedExample.astro";
import CommonMistakes from "../components/content/CommonMistakes.astro";
import Tips from "../components/content/Tips.astro";

import { createSEO } from "../seo";

import { percentageIncreaseDecreaseFAQ } from "../data/faqs";
import { percentageIncreaseDecreaseFormula } from "../data/formulas";
import { percentageTopic } from "../data/topics";
import { percentageIncreaseDecreaseContent } from "../data/content";

const seo = createSEO({
  title: "Percentage Increase or Decrease Calculator (Free Online)",

  description:
    "Calculate whether a value increased or decreased and by what percentage. Free online percentage increase and decrease calculator.",

  canonical: "/percentage-increase-decrease",

  keywords: [
    "percentage increase and decrease calculator",
    "percentage change calculator",
    "increase or decrease percentage",
    "percentage comparison calculator",
  ],
});
---

<BaseLayout seo={seo}>
  <FAQSchema section={percentageIncreaseDecreaseFAQ} />
  <FormulaSchema section={percentageIncreaseDecreaseFormula} />
  <ContentSchema section={percentageIncreaseDecreaseContent} />

  <Section>
    <Container>
      <div class="mx-auto max-w-5xl">
        <div class="mb-10 text-center">
          <Heading as="h1">
            Percentage Increase / Decrease Calculator
          </Heading>

          <div class="mx-auto mt-4 max-w-3xl">
            <Text size="lg">
              Compare two values and instantly see whether the result is a
              percentage increase or decrease.
            </Text>
          </div>
        </div>

        <Card class="p-8">
          <PercentageIncreaseDecreaseCalculator />
        </Card>

        <div class="mt-10">
          <RelatedCalculators currentSlug="percentage-increase-decrease" />
        </div>

        <div class="mt-12">
          <TopicLinks
            topic={percentageTopic}
            currentSlug="/percentage-increase-decrease"
          />
        </div>

        <div class="mt-12">
          <Formula section={percentageIncreaseDecreaseFormula} />
        </div>

        <div class="mt-12">
          <HowItWorks section={percentageIncreaseDecreaseContent.howItWorks} />
        </div>

        <div class="mt-12">
          <WorkedExample section={percentageIncreaseDecreaseContent.example} />
        </div>

        <div class="mt-12">
          <CommonMistakes
            section={percentageIncreaseDecreaseContent.commonMistakes}
          />
        </div>

        <div class="mt-12">
          <Tips section={percentageIncreaseDecreaseContent.tips} />
        </div>

        <div class="mt-12">
          <FAQ section={percentageIncreaseDecreaseFAQ} />
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>